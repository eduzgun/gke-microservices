ENVIRONMENT=dev

GOOSE_DRIVER=postgres
GOOSE_DBSTRING="host=localhost port=5432 user=YOURUSER password=YOURPASSWORD dbname=gke_microservices sslmode=disable"
GOOSE_MIGRATION_DIR=./internal/db/migrations

PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_USER=YOURUSER
PSQL_PASSWORD=YOURPASSWORD
PSQL_NAME=gke_microservices
PSQL_SSL_MODE=disable

API_PORT=8080
SESSION_SERVICE_ADDR=localhost:9090
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"